# AWS SES Configuration (contact form)
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=your_access_key_id
VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key
VITE_VERIFIED_EMAIL=your_verified_email@example.com

# Content source (optional)
# Defaults to /content when unset. For production, point to your S3 bucket URL.
# VITE_CONTENT_BASE_URL=https://your-bucket.s3.amazonaws.com
